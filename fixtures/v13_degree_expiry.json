    {
      "id": "degree_caption_01",
      "start_frame": 120,
      "end_frame": 240,
      "text": "2026. A new law:\nrenew it, or lose it.",
      "claim_ids": [
        "degree_law",
        "degree_count"
      ]
    },
    {
      "id": "degree_caption_02",
      "start_frame": 240,
      "end_frame": 360,
      "text": "Your knowledge stays.\nYour credential has a timer.",
      "claim_ids": [
        "degree_law",
        "degree_count"
      ]
    },
    {
      "id": "degree_caption_03",
      "start_frame": 360,
      "end_frame": 480,
      "text": "2031. Your degree expires.\nYour job wants proof.",
