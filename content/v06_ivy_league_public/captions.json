      "factIds": [
        "v06.h.in_state"
      ]
    },
    {
      "id": "cap_09",
      "beat": "consequence",
      "startFrame": 1260,
      "endFrame": 1440,
      "text": "Problem 3: Public doesn't mean free. Surprise!",
