      "chapterStamp": "OPEN HOUSE"
    },
    {
      "id": "cap_08",
      "beat": "consequence",
      "startFrame": 1080,
      "endFrame": 1260,
      "text": "Problem 2: Lawmakers now vote on their budgets.",
