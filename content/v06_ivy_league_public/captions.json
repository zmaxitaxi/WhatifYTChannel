      ]
    },
    {
      "id": "cap_04",
      "beat": "transform",
      "startFrame": 360,
      "endFrame": 510,
      "text": "Then each state takes control of its Ivy.",
      "sourceLabel": "Imagined status change",
      "isHypothetical": true
    },
    {
      "id": "cap_05",
      "beat": "transform",
      "startFrame": 510,
      "endFrame": 750,
      "text": "Eight iron gates swing open at once.",
