    {
      "id": "cap_02",
      "beat": "establish",
      "startFrame": 90,
      "endFrame": 225,
      "text": "There are eight Ivy League schools.",
      "sourceLabel": "Ivy League",
      "isHypothetical": false,
      "factIds": [
        "v06.f.members"
      ]
    },
    {
      "id": "cap_03",
      "beat": "establish",
      "startFrame": 225,
      "endFrame": 360,
      "text": "All private. All old. All very hard to get into.",
